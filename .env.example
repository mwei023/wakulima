# Wakulima shop server (docker-compose.yml) — copy to .env on the shop
# machine and fill in. NEVER commit the real .env (gitignored).
# Rotate ADMIN_TOKEN/BACKUP_TOKEN if a till is retired.

# Postgres login for the sync database.
POSTGRES_PASSWORD=change-me-strong

# Mints device tokens: POST /devices with header x-admin-token.
ADMIN_TOKEN=change-me-strong

# The 2.1 snapshot receiver write token; set the same value in the till's
# Settings → Off-device backup.
BACKUP_TOKEN=change-me-strong
